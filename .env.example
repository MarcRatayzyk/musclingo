# Database
DATABASE_URL=postgresql://musclemind:musclemind@localhost:5432/musclemind?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin seed
ADMIN_EMAIL=admin@musclemind.app
ADMIN_PASSWORD=Admin123!

# API
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082
# Déverrouille toutes les leçons par défaut ; mettre false pour la progression séquentielle
UNLOCK_ALL_LESSONS=true

# PostHog
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_API_URL=http://localhost:3001

# RevenueCat (phase 2)
REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Admin
NEXT_PUBLIC_API_URL=http://localhost:3001
