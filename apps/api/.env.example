DATABASE_URL=postgresql://musclemind:musclemind@localhost:5432/musclemind?schema=public
REDIS_URL=redis://localhost:6379
# Production (Railway): REDIS_URL=${{Redis.REDIS_URL}}?family=0
# Also accepted: REDIS_PRIVATE_URL / REDIS_PUBLIC_URL
# Required at boot — min 32 characters each (no hardcoded fallback)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_EMAIL=admin@musclemind.app
ADMIN_PASSWORD=Admin123!
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082
UNLOCK_ALL_LESSONS=false
# Production: seed only when RUN_SEED=1 (create-only admin; never resets password)
# RUN_SEED=1
# SEED_DEMO_USER=1
DEMO_PAYMENTS=false
