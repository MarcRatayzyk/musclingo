generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  SINGLE
  TRUE_FALSE
  MULTI
  ORDER
  MATCH
  TEXT
  HOTSPOT
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  passwordHash         String
  displayName          String
  avatarUrl            String?
  role                 Role             @default(USER)
  xpTotal              Int              @default(0)
  level                Int              @default(1)
  memoryGameBestScore  Int              @default(0)
  preferredCategoryId  String?
  preferredCategory    Category?        @relation("PreferredCategory", fields: [preferredCategoryId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  lessonProgress         LessonProgress[]
  quizResults            QuizResult[]
  quizSessions           QuizSession[]
  checkpointGateResults  CheckpointGateResult[]
  miniGameResults        MiniGameResult[]
  xpTransactions         XpTransaction[]
  streak               Streak?
  badges               UserBadge[]
  notifications        Notification[]

  @@index([xpTotal])
}

model Category {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  color        String
  icon         String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lessons          Lesson[]
  checkpointGates  CheckpointGate[]
  miniGameQuestions MiniGameQuestion[]
  miniGameResults   MiniGameResult[]
  preferredBy      User[]   @relation("PreferredCategory")
}

model Lesson {
  id               String           @id @default(cuid())
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title            String
  subtitle         String?
  markdown         String
  durationSec      Int              @default(90)
  difficulty       Difficulty       @default(BEGINNER)
  illustrationUrl  String?
  order            Int              @default(0)
  checkpointKey    String           @default("bases")
  checkpointTitle  String           @default("Bases")
  checkpointOrder  Int              @default(0)
  tags             String[]         @default([])
  sources          String[]         @default([])
  recommendedLevel Int              @default(1)
  xpReward         Int              @default(25)
  status           LessonStatus     @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  quiz             Quiz?
  progress         LessonProgress[]

  @@index([categoryId, order])
  @@index([categoryId, checkpointOrder])
  @@index([status])
}

model Quiz {
  id             String       @id @default(cuid())
  lessonId       String       @unique
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  xpReward       Int          @default(40)
  perfectBonusXp Int          @default(20)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  questions      Question[]
  results        QuizResult[]
  sessions       QuizSession[]
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType
  prompt      String
  explanation String
  order       Int          @default(0)
  payload     Json?
  answers     Answer[]

  @@index([quizId, order])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  matchKey   String?

  @@index([questionId, order])
}

model LessonProgress {
  id             String         @id @default(cuid())
  userId         String
  lessonId       String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status         ProgressStatus @default(NOT_STARTED)
  completedAt    DateTime?
  readingTimeSec Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

model QuizResult {
  id           String   @id @default(cuid())
  userId       String
  quizId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score        Float
  perfect      Boolean  @default(false)
  xpEarned     Int
  answers      Json
  stars        Int      @default(0)
  timeSpentSec Int?
  passed       Boolean  @default(false)
  questionIds  Json     @default("[]")
  createdAt    DateTime @default(now())

  @@index([userId, quizId])
}

model QuizSession {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionIds Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId, quizId])
}

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Streak {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  current          Int      @default(0)
  longest          Int      @default(0)
  lastActivityDate DateTime?
  updatedAt        DateTime @updatedAt
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String
  icon        String
  createdAt   DateTime    @default(now())
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())
}

model CheckpointGate {
  id              String                 @id @default(cuid())
  categoryId      String
  category        Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  checkpointKey   String
  checkpointOrder Int
  title           String
  timeLimitSec    Int                    @default(60)
  passThreshold   Float                  @default(0.9)
  questionCount   Int                    @default(20)
  xpReward        Int                    @default(50)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  questions       CheckpointQuestion[]
  results         CheckpointGateResult[]

  @@unique([categoryId, checkpointKey])
  @@index([categoryId, checkpointOrder])
}

model CheckpointQuestion {
  id          String              @id @default(cuid())
  gateId      String
  gate        CheckpointGate      @relation(fields: [gateId], references: [id], onDelete: Cascade)
  type        QuestionType
  prompt      String
  explanation String
  order       Int                 @default(0)
  answers     CheckpointAnswer[]

  @@index([gateId, order])
}

model CheckpointAnswer {
  id         String             @id @default(cuid())
  questionId String
  question   CheckpointQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean            @default(false)
  order      Int                @default(0)

  @@index([questionId, order])
}

model CheckpointGateResult {
  id           String         @id @default(cuid())
  userId       String
  gateId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gate         CheckpointGate @relation(fields: [gateId], references: [id], onDelete: Cascade)
  score        Float
  passed       Boolean
  timeSpentSec Int
  xpEarned     Int
  answers      Json
  createdAt    DateTime       @default(now())

  @@index([userId, gateId])
}

model MiniGameQuestion {
  id            String             @id @default(cuid())
  categoryId    String
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  checkpointKey String?
  type          QuestionType
  prompt        String
  explanation   String
  order         Int                @default(0)
  payload       Json?
  answers       MiniGameAnswer[]

  @@index([categoryId, order])
}

model MiniGameAnswer {
  id         String           @id @default(cuid())
  questionId String
  question   MiniGameQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean          @default(false)
  order      Int              @default(0)

  @@index([questionId, order])
}

model MiniGameResult {
  id           String   @id @default(cuid())
  userId       String
  categoryId   String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  gameKey      String   @default("flash-quiz")
  durationSec  Int
  correctCount Int
  wrongCount   Int
  bestCombo    Int      @default(0)
  score        Int
  endedBy      String
  createdAt    DateTime @default(now())

  @@index([userId, categoryId, score])
}
