{
  "name": "muscle-mind",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @muscle-mind/api dev",
    "dev:web": "pnpm --filter @muscle-mind/mobile dev:web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @muscle-mind/api prisma:generate",
    "db:migrate": "pnpm --filter @muscle-mind/api prisma:migrate",
    "db:seed": "pnpm --filter @muscle-mind/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "~19.1.10",
      "@types/react-dom": "~19.1.7"
    }
  }
}
